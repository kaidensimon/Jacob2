 "beats": [
  {
   "say": "Alright mate, this bit's the water cycle: water doesn't just sit there doing bugger all, it keeps moving in a big round loop.",
   "reveal": [
    "title"
   ],
   "emphasize": [
    "title"
   ]
  },
  {
   "say": "We’ll start with the big stash of water, like the ocean and lakes, where heaps of water is collected.",
   "reveal": [
    "ocean"
   ],
   "emphasize": [
    "ocean"
   ]
  },
  {
   "say": "The Sun warms that water, and that heat gives some water enough energy to head upward as invisible water vapour. Too easy.",
   "reveal": [
    "sun",
    "evapArrow",
    "evapLabel"
   ],
   "emphasize": [
    "sun",
    "evapArrow",
    "ocean"
   ]
  },
  {
   "say": "Up in the cooler air, that vapour turns back into tiny liquid drops, and those drops make clouds. That change is called condensation, bloody handy word.",
   "reveal": [
    "clouds",
    "condenseNote"
   ],
   "emphasize": [
    "clouds"
   ]
  },
  {
   "say": "When the drops in the cloud get heavy enough, they fall back down as rain, snow, hail, or sleet. That's precipitation, mate.",
   "reveal": [
    "precipArrow",
    "rainDrops",
    "land"
   ],
   "emphasize": [
    "precipArrow",
    "rainDrops"
   ]
  },
  {
   "say": "Then the fallen water gathers on land and flows downhill into rivers, lakes, and back to the ocean. That's collection and runoff, no dramas.",
   "reveal": [
    "collectArrow"
   ],
   "emphasize": [
    "collectArrow",
    "land",
    "ocean"
   ]
  },
  {
   "say": "And here's the ripper idea: it loops around again and again — evaporation, condensation, precipitation, collection — round and round she goes.",
   "reveal": [
    "loopNote"
   ],
   "emphasize": [
    "evapArrow",
    "clouds",
    "precipArrow",
    "collectArrow",
    "loopNote"
   ]
  }
 ]
}